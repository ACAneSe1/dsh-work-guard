{
  "name": "dsh-work-guard",
  "version": "0.15.7",
  "description": "Work discipline for coding agents: read before write, a change ledger, and detection of writes that bypassed the tools.",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "cordis", "agent", "guard", "guardrails", "ledger", "workflow", "code-review"],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "test",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.4.0-0"
    }
  }
}
